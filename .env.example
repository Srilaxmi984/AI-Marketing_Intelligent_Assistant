# Target site configuration
TARGET_SITE=https://www.hubspot.com
CONTACT_EMAIL=b23ai070@kitsw.ac.in

# Crawler defaults
DEFAULT_MAX_PAGES=25
MAX_PAGES_CAP=100
MAX_CRAWL_DEPTH=3
CRAWL_CONCURRENCY=5
CONNECT_TIMEOUT_S=5.0
READ_TIMEOUT_S=10.0
CRAWL_TIME_BUDGET_S=60.0
MAX_BODY_BYTES=2097152
MAX_REDIRECTS=5

# Link checker
MAX_LINK_CHECKS=300
LINK_CHECK_CONCURRENCY=5

# Security
ALLOW_PRIVATE_TARGETS=false

# LLM integration (Gemini REST API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LLM_TIMEOUT_S=20.0
